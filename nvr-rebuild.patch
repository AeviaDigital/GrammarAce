+    {shape:shapeA,attr:attrValues[1],code:shapeLetterA+attr2Letter},
+    {shape:shapeB,attr:attrValues[0],code:shapeLetterB+attr1Letter},
+    {shape:shapeB,attr:attrValues[1],code:shapeLetterB+attr2Letter}
